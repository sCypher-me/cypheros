[Icon Theme]
Name=Prisma
Comment=Ícones do CypherOS: vidro escuro e gradiente ciano-violeta
Inherits=Papirus-Dark,hicolor
Example=folder
Directories=scalable/apps,scalable/places,scalable/mimetypes

[scalable/apps]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=8
MaxSize=512
Type=Scalable
Context=MimeTypes
