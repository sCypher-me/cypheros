#version 440
// Degradê no texto (relógio): branco → ciano → violeta.
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec4 c1;
    vec4 c2;
    vec4 c3;
};
layout(binding = 1) uniform sampler2D source;
void main() {
    vec4 s = texture(source, qt_TexCoord0);
    float t = clamp(qt_TexCoord0.x * 0.8 + (1.0 - qt_TexCoord0.y) * 0.2, 0.0, 1.0);
    vec3 c = t < 0.4 ? c1.rgb : t < 0.8 ? mix(c1.rgb, c2.rgb, (t - 0.4) / 0.4) : mix(c2.rgb, c3.rgb, (t - 0.8) / 0.2);
    fragColor = vec4(c * s.a, s.a) * qt_Opacity;
}
